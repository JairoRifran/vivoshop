{
  "name": "@vivo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Transport contracts shared by the API and every client: schemas, DTOs, HTTP client and the analytics catalogue.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@vivo/config": "workspace:*",
    "@vivo/domain": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
