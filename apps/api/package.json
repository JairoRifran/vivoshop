{
  "name": "@vivo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vivo API — modular monolith. HTTP in, use cases, domain, swappable infrastructure.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/infrastructure/persistence/drizzle/migrate.ts",
    "db:seed": "tsx src/infrastructure/persistence/drizzle/seed.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "db:smoke": "tsx src/infrastructure/persistence/drizzle/smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.2.1",
    "@vivo/config": "workspace:*",
    "@vivo/domain": "workspace:*",
    "@vivo/seed": "workspace:*",
    "@vivo/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.9",
    "livekit-server-sdk": "2.18.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
