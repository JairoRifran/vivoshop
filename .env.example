# ---------------------------------------------------------------------------
# Vivo — example environment. Copy to `.env` and adjust.
#   cp .env.example .env
# Every value below is safe for local development. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Drivers -----------------------------------------------------------------
# memory   -> no infrastructure required, dataset seeded in-process (default)
# postgres -> requires DATABASE_URL and `pnpm db:up && pnpm db:push && pnpm db:seed`
DATA_DRIVER=memory
# memory | redis
CACHE_DRIVER=memory

# --- Datastores --------------------------------------------------------------
DATABASE_URL=postgresql://vivo:vivo@localhost:5432/vivo
# TLS contra Postgres.
#   auto      -> texto plano en localhost, TLS verificado en cualquier otro lado
#   require   -> TLS con verificación de certificado
#   no-verify -> TLS sin verificar la cadena. Es lo que hace conectar a Supabase
#                sin su CA, a cambio de quedar expuesto a un intermediario
#                activo. Mejor cargar DATABASE_CA_CERT.
#   disable   -> sin TLS
DATABASE_SSL=auto
# PEM de la CA que firmó el certificado de la base. La opción correcta.
DATABASE_CA_CERT=
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------
API_PORT=4000
# Comma separated list of origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# Signing key for access tokens. MUST be replaced outside local development.
JWT_SECRET=dev-only-insecure-secret-change-me-please-32chars
JWT_EXPIRES_IN=7d
# Requests per minute per IP.
RATE_LIMIT=120
# Confiar en X-Forwarded-For de un salto. Por defecto: true en producción
# (siempre hay un balanceador delante), false en local — confiar en la cabecera
# cuando nadie la limpia deja que cualquiera elija su IP y esquive el límite.
TRUST_PROXY=

# --- Streaming ---------------------------------------------------------------
# mock    -> no account, no Docker, no camera pipeline. The default, and what a
#            fresh clone and the whole test suite run on.
# livekit -> real WebRTC. Needs the three values below; the API refuses to boot
#            without them, rather than failing at the first "Transmitir".
STREAMING_PROVIDER=mock

# Local server:  ws://127.0.0.1:7880   (see docs/live-testing.md)
# LiveKit Cloud: wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
# NEVER expose this to the browser, and never prefix it with NEXT_PUBLIC_.
# Access tokens are minted on the server, per participant, and expire.
LIVEKIT_API_SECRET=
# How long a join token is valid. Short enough to limit a leak, long enough
# that a normal broadcast never has to renew mid-sale.
LIVEKIT_BROADCASTER_TTL_SECONDS=14400
LIVEKIT_VIEWER_TTL_SECONDS=3600

# --- Cobros ------------------------------------------------------------------
# fake        -> sin cuenta, sin credenciales, sin internet. El default, y lo que
#                corre un clon fresco y toda la suite de pruebas.
# mercadopago -> cobros reales. Exige los tres valores de abajo; la API se niega
#                a arrancar sin ellos en vez de fallar en el primer cobro.
PAYMENT_PROVIDER=fake

# De la aplicacion en https://mercadopago.com.uy/developers/panel
MERCADOPAGO_CLIENT_ID=
# NUNCA en el navegador, nunca con prefijo NEXT_PUBLIC_, nunca en un log.
MERCADOPAGO_CLIENT_SECRET=
# En sandbox empieza con TEST-. El arranque avisa si no, porque cobrarle de
# verdad a alguien que estaba probando es el error caro de este milestone.
MERCADOPAGO_ACCESS_TOKEN=
# Del panel de Webhooks. Sin esto los avisos no se pueden verificar, y el
# endpoint seria un boton publico para marcar pedidos como pagos.
MERCADOPAGO_WEBHOOK_SECRET=

# Base publica de la API. Arma el callback de OAuth y la notification_url que
# recibe el proveedor, asi que tiene que ser alcanzable desde internet.
API_PUBLIC_URL=http://localhost:4000

# --- Modo Puja ---------------------------------------------------------------
# Cuanto tiene el ganador de una puja para pagar antes de que el producto vuelva
# al stock. Vive aca y en DEFAULT_BID_RESERVATION_SECONDS del dominio, y en
# ningun otro lado: es de los valores que se ajustan con datos reales.
BID_RESERVATION_TTL_SECONDS=300
# Cuanto se le guarda el stock a un checkout que nadie paga. Sin esto la reserva
# es eterna: quien abre el checkout y se va deja el producto trabado para
# siempre. Si el proveedor pone su propia fecha de vencimiento, gana la suya.
CHECKOUT_RESERVATION_TTL_SECONDS=1800

# --- Cifrado en reposo (M04.1) -----------------------------------------------
# Protege las credenciales OAuth de los vendedores guardadas en la base. Con un
# access token de Mercado Pago se puede cobrar y devolver en nombre de otro, asi
# que una copia de la base no puede alcanzar para eso.
#
# 32 bytes en base64. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Obligatoria en produccion: sin ella el proceso no arranca. Fuera de produccion
# se usa una clave de desarrollo que no protege nada, para que el camino de
# cifrado se ejecute igual en las pruebas.
ENCRYPTION_KEY=
# Solo mientras dure una rotacion, y solo descifra. Poner la nueva arriba y la
# vieja aca permite rotar sin ventana de indisponibilidad.
ENCRYPTION_KEY_PREVIOUS=

# --- Avisos (M05) ------------------------------------------------------------
# `log` escribe una linea y no molesta a nadie, que es por que es el default: un
# clon del repositorio arranca sin que nadie genere claves. `webpush` es el
# camino real, y exige las dos claves de abajo o el proceso no arranca.
NOTIFICATION_PROVIDER=log
# Generalas con:
#   pnpm --filter @vivo/api exec web-push generate-vapid-keys
# La publica puede llegar al navegador --la necesita para suscribirse--. La
# privada nunca sale del servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A quien contactar si los avisos molestan. Los servicios de push lo exigen y lo
# usan para avisarle a un humano antes de bloquear un remitente.
VAPID_SUBJECT=mailto:hola@vivoshop.uy

# --- Web ---------------------------------------------------------------------
# Used by the browser. Anything prefixed NEXT_PUBLIC_ is shipped to the client:
# never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Vivo
NEXT_PUBLIC_DEFAULT_COUNTRY=UY
# Server-side base URL (container networking may differ from the public one).
INTERNAL_API_URL=http://localhost:4000

# --- Imagenes (M06) ----------------------------------------------------------
# `local` guarda los bytes en memoria y los pierde al reiniciar, que es por que
# es el default: un clon del repositorio arranca sin contratar un bucket.
# `supabase` es el camino real, y en produccion es obligatorio -- el arranque
# falla con `local` porque cada deploy borraria las fotos de todo el mundo.
STORAGE_PROVIDER=local
# El proyecto de Supabase, p. ej. https://abcdefgh.supabase.co
SUPABASE_URL=
# Settings -> API -> `service_role`. Es la credencial mas poderosa del proyecto:
# salta las politicas de fila. Nunca sale del servidor, nunca va al navegador.
SUPABASE_SERVICE_KEY=
# El bucket, que tiene que existir y ser publico de lectura: los logos se
# muestran en grillas y firmar cada miniatura seria pagar una consulta por cada
# imagen que alguien mira.
SUPABASE_STORAGE_BUCKET=vivoshop-media

# --- Ingresar con Google / Meta (M07) ---------------------------------------
# Que proveedores se ofrecen, separados por coma: fake | google | meta.
#
# `fake` es el default y se monta bajo el nombre `google`, asi que desarrollo
# ejercita exactamente las mismas rutas que produccion sin credenciales. En
# produccion esta prohibido --seria un boton que entrega una cuenta de
# demostracion a cualquiera-- y el proceso se niega a arrancar asi.
# Vacio apaga el ingreso social y la pantalla no dibuja ningun boton.
OAUTH_PROVIDERS=fake

# De la consola de Google: APIs y servicios -> Credenciales -> ID de cliente
# de OAuth 2.0, tipo "Aplicacion web".
#
# En "URI de redireccion autorizados" va, exactamente:
#   http://localhost:4000/auth/google/callback        (desarrollo)
#   https://<tu-api>/auth/google/callback             (produccion)
# Tiene que coincidir caracter por caracter con API_PUBLIC_URL + la ruta.
GOOGLE_CLIENT_ID=
# Nunca sale del servidor. Nunca se commitea.
GOOGLE_CLIENT_SECRET=

# Meta todavia no tiene adaptador propio. Las variables se aceptan para poder
# cargarlas antes, pero `OAUTH_PROVIDERS=meta` monta el proveedor simulado.
META_APP_ID=
META_APP_SECRET=

# --- Correo (M08) -----------------------------------------------------------
# Como se manda el correo: log | none | resend.
#
# `log` lo escribe en la consola y es el default: el flujo de recuperacion se
# recorre entero sin contratar nada, haciendo clic en el enlace que aparece en
# la terminal. En produccion esta PROHIBIDO --la pantalla diria "te mandamos un
# email" y nadie recibiria nada-- y el arranque se niega.
#
# `none` apaga la recuperacion de frente: la pantalla no ofrece el enlace. Es
# una produccion valida, y mejor que fingir la funcion.
EMAIL_PROVIDER=log

# De resend.com. El dominio del remitente tiene que estar verificado alla.
RESEND_API_KEY=
EMAIL_FROM=VivoShop <hola@vivoshop.live>

# Base publica de la web, para armar el enlace del correo. Si falta, se usa el
# primer origen de WEB_ORIGIN. Nunca se toma del Host de la peticion: eso
# dejaria que alguien se haga mandar un enlace apuntando a su dominio.
WEB_PUBLIC_URL=http://localhost:3000
